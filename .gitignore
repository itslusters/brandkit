# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Brainstorm session files
.superpowers/
/docs/superpowers/

# Serwist generated service worker
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# clerk configuration (can include secrets)
/.clerk/

# Capacitor iOS — generated Pods/DerivedData; keep the Xcode project checked in
/ios/App/Pods/
/ios/App/App/public/
/ios/DerivedData/
/ios/App/build/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
